# Flask session security
SECRET_KEY=replace-with-a-long-random-value

# Local development uses SQLite by default.
# DATABASE_URL=sqlite:///patient_case.db

# To use MySQL instead, leave DATABASE_URL empty and enable this:
# USE_MYSQL=true
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DATABASE=patient_case_db

# Optional OCR and AI settings
# TESSERACT_CMD=
# POPPLER_PATH=
# AI_PROVIDER=none
# AI_API_KEY=
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_MODEL=gpt-4o-mini
